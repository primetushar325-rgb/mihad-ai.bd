# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Production hostname only, without https:// (used by Caddy)
DOMAIN=localhost
TRUST_PROXY=0

# Database & session
MONGODB_URI=mongodb://127.0.0.1:27017/mihad-ai
SESSION_SECRET=replace-with-at-least-32-random-characters
# 32 random bytes encoded as base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud / YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000

# Optional OpenAI-compatible AI provider (keys never reach the browser)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Uploads
MAX_VIDEO_SIZE_MB=5120
MAX_THUMBNAIL_SIZE_MB=2
FAILED_UPLOAD_RETENTION_HOURS=24

# CORS (comma-separated; same-origin is always accepted)
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
